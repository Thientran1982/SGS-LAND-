# ============================================
# SGS NEXT — Environment Variables (EXAMPLE)
# Copy to .env and fill with real values.
# NEVER commit the real .env file.
# ============================================

# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sgs_next"
REDIS_URL="redis://HOST:6379"

# --- Auth ---
JWT_ACCESS_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

OTP_PROVIDER="twilio" # or "vonage", "esms"
OTP_API_KEY=""

# --- Storage ---
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY=""
CLOUDFLARE_R2_SECRET_KEY=""
CLOUDFLARE_R2_BUCKET="sgs-next-media"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- AI ---
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_GEMINI_API_KEY=""
VECTOR_DB_URL="" # e.g. pgvector via DATABASE_URL, or Pinecone/Weaviate URL

# --- Realtime ---
SOCKET_IO_CORS_ORIGIN="https://sgsland.vn"

# --- App ---
NODE_ENV="development"
APP_URL="http://localhost:3000"
API_URL="http://localhost:4000"
DEFAULT_TENANT_SLUG="sgs-land"
