// ============================================================
//  SGS NEXT — Enterprise PropTech Platform
//  PostgreSQL schema (Prisma ORM)
//  Multi-tenant, RBAC, Clean Architecture core data model
// ============================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, vector]
}

// ---------------------- ENUMS ----------------------

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum AuthProvider {
  EMAIL
  GOOGLE
  FACEBOOK
  APPLE
  OTP
}

enum PropertyType {
  APARTMENT
  VILLA
  TOWNHOUSE
  SHOPHOUSE
  LAND
  OFFICE
  WAREHOUSE
  HOTEL
  FARM
}

enum ListingType {
  SALE
  RENT
  TRANSFER
}

enum PropertyStatus {
  DRAFT
  PENDING
  PUBLISHED
  SOLD
  RENTED
  ARCHIVED
}

enum LegalStatus {
  RED_BOOK
  PINK_BOOK
  SALE_CONTRACT
  PENDING
  DISPUTED
  UNKNOWN
}

enum Direction {
  EAST
  WEST
  SOUTH
  NORTH
  SOUTHEAST
  SOUTHWEST
  NORTHEAST
  NORTHWEST
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  AI_CHAT
  REFERRAL
  ADS
  SOCIAL
  ZALO
  CALL
  WALK_IN
}

enum TransactionStatus {
  RESERVED
  DEPOSITED
  CONTRACTED
  COMPLETED
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NotificationType {
  SYSTEM
  LEAD
  MESSAGE
  APPOINTMENT
  TRANSACTION
  MARKETING
}

enum MediaType {
  IMAGE
  VIDEO
  TOUR_360
  FLOOR_PLAN
  DOCUMENT
  BROCHURE
}

// ---------------------- MULTI-TENANCY ----------------------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  domain    String?  @unique
  logoUrl   String?
  settings  Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  properties      Property[]
  projects        Project[]
  developers      Developer[]
  leads           Lead[]
  transactions    Transaction[]
  visitorProfiles VisitorProfile[]
  trackingEvents  TrackingEvent[]

  @@index([slug])
}

// ---------------------- RBAC ----------------------

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. property.create
  description String?
  roles       RolePermission[]
}

model Role {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique // ADMIN, BROKER, CUSTOMER, MANAGER
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

// ---------------------- USERS & PROFILES ----------------------

model User {
  id               String       @id @default(cuid())
  tenantId         String
  email            String
  phone            String?
  passwordHash     String?
  fullName         String
  avatarUrl        String?
  provider         AuthProvider @default(EMAIL)
  providerId       String?
  status           UserStatus   @default(PENDING)
  emailVerified    Boolean      @default(false)
  phoneVerified    Boolean      @default(false)
  twoFactorEnabled Boolean      @default(false)
  locale           String       @default("vi")
  lastLoginAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  roles           UserRole[]
  brokerProfile   BrokerProfile?
  customerProfile CustomerProfile?
  sessions        Session[]
  notifications   Notification[]
  favorites       Favorite[]
  savedSearches   SavedSearch[]
  reviews         Review[]
  sentMessages    Message[]        @relation("MessageSender")
  aiConversations AiConversation[]
  auditLogs       AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([provider, providerId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BrokerProfile {
  id             String        @id @default(cuid())
  userId         String        @unique
  licenseNo      String?
  bio            String?
  agencyName     String?
  rating         Float         @default(0)
  totalSales     Int           @default(0)
  commissionRate Float         @default(0)
  rank           String?
  isVerified     Boolean       @default(false)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties     Property[]
  leads          Lead[]
  appointments   Appointment[]
  transactions   Transaction[]
}

model CustomerProfile {
  id             String        @id @default(cuid())
  userId         String        @unique
  budgetMin      Decimal?      @db.Decimal(15, 2)
  budgetMax      Decimal?      @db.Decimal(15, 2)
  preferredAreas String[]
  interests      Json          @default("{}")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  transactions   Transaction[]
}

// ---------------------- LOCATION ----------------------

model Province {
  id         String     @id @default(cuid())
  name       String
  slug       String     @unique
  code       String?    @unique
  districts  District[]
  properties Property[]
  projects   Project[]
}

model District {
  id         String     @id @default(cuid())
  provinceId String
  name       String
  slug       String
  province   Province   @relation(fields: [provinceId], references: [id])
  wards      Ward[]
  properties Property[]
  projects   Project[]

  @@unique([provinceId, slug])
}

model Ward {
  id         String     @id @default(cuid())
  districtId String
  name       String
  slug       String
  district   District   @relation(fields: [districtId], references: [id])
  properties Property[]

  @@unique([districtId, slug])
}

// ---------------------- DEVELOPER & PROJECT ----------------------

model Developer {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  logoUrl     String?
  description String?
  website     String?
  foundedYear Int?
  createdAt   DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  projects Project[]

  @@unique([tenantId, slug])
}

model Project {
  id                   String      @id @default(cuid())
  tenantId             String
  developerId          String
  provinceId           String?
  districtId           String?
  name                 String
  slug                 String
  description          String?
  masterPlanUrl        String?
  totalUnits           Int?
  totalArea            Float?
  priceFrom            Decimal?    @db.Decimal(15, 2)
  priceTo              Decimal?    @db.Decimal(15, 2)
  legalStatus          LegalStatus @default(UNKNOWN)
  constructionProgress Int         @default(0)
  handoverDate         DateTime?
  latitude             Float?
  longitude            Float?
  metaTitle            String?
  metaDescription      String?
  isFeatured           Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  developer  Developer        @relation(fields: [developerId], references: [id])
  province   Province?        @relation(fields: [provinceId], references: [id])
  district   District?        @relation(fields: [districtId], references: [id])
  phases     ProjectPhase[]
  properties Property[]
  media      Media[]
  amenities  ProjectAmenity[]
  promotions Promotion[]

  @@unique([tenantId, slug])
  @@index([tenantId, isFeatured])
}

model ProjectPhase {
  id         String    @id @default(cuid())
  projectId  String
  name       String
  unitsTotal Int       @default(0)
  unitsSold  Int       @default(0)
  launchDate DateTime?
  status     String    @default("UPCOMING")
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Amenity {
  id       String           @id @default(cuid())
  name     String           @unique
  icon     String?
  category String?
  projects ProjectAmenity[]
}

model ProjectAmenity {
  projectId String
  amenityId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([projectId, amenityId])
}

model Promotion {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ---------------------- PROPERTY ----------------------

model Property {
  id              String         @id @default(cuid())
  tenantId        String
  brokerId        String?
  projectId       String?
  provinceId      String?
  districtId      String?
  wardId          String?
  title           String
  slug            String
  description     String?
  type            PropertyType
  listingType     ListingType    @default(SALE)
  status          PropertyStatus @default(DRAFT)
  price           Decimal        @db.Decimal(15, 2)
  pricePerSqm     Decimal?       @db.Decimal(15, 2)
  area            Float
  bedrooms        Int?
  bathrooms       Int?
  floors          Int?
  direction       Direction?
  legalStatus     LegalStatus    @default(UNKNOWN)
  address         String?
  latitude        Float?
  longitude       Float?
  isVerified      Boolean        @default(false)
  isFeatured      Boolean        @default(false)
  viewCount       Int            @default(0)
  metaTitle       String?
  metaDescription String?
  publishedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant         Tenant                 @relation(fields: [tenantId], references: [id])
  broker         BrokerProfile?         @relation(fields: [brokerId], references: [id])
  project        Project?               @relation(fields: [projectId], references: [id])
  province       Province?              @relation(fields: [provinceId], references: [id])
  district       District?              @relation(fields: [districtId], references: [id])
  ward           Ward?                  @relation(fields: [wardId], references: [id])
  media          Media[]
  favorites      Favorite[]
  reviews        Review[]
  priceHistory   PropertyPriceHistory[]
  valuations     AiValuation[]
  leads          Lead[]
  transactions   Transaction[]
  appointments   Appointment[]
  legalDocuments LegalDocument[]
  trackingEvents TrackingEvent[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, listingType])
  @@index([type, price])
  @@index([provinceId, districtId])
}

model PropertyPriceHistory {
  id         String   @id @default(cuid())
  propertyId String
  price      Decimal  @db.Decimal(15, 2)
  recordedAt DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, recordedAt])
}

model Media {
  id           String    @id @default(cuid())
  propertyId   String?
  projectId    String?
  type         MediaType
  url          String
  thumbnailUrl String?
  altText      String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())

  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([projectId])
}

// ---------------------- CRM ----------------------

model Lead {
  id            String     @id @default(cuid())
  tenantId      String
  brokerId      String?
  propertyId    String?
  customerName  String
  customerPhone String?
  customerEmail String?
  source        LeadSource @default(WEBSITE)
  status        LeadStatus @default(NEW)
  score         Int        @default(0)
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  broker          BrokerProfile?   @relation(fields: [brokerId], references: [id])
  property        Property?        @relation(fields: [propertyId], references: [id])
  tasks           Task[]
  calls           CallLog[]
  messages        Message[]
  appointments    Appointment[]
  activities      LeadActivity[]
  visitorProfiles VisitorProfile[]

  @@index([tenantId, status])
  @@index([brokerId, status])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String // STATUS_CHANGE, NOTE, EMAIL_SENT, CALL, etc.
  payload   Json     @default("{}")
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

model Task {
  id          String    @id @default(cuid())
  leadId      String?
  assignedTo  String
  title       String
  description String?
  dueDate     DateTime?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([assignedTo, isCompleted])
}

model CallLog {
  id           String   @id @default(cuid())
  leadId       String
  direction    String // INBOUND, OUTBOUND
  duration     Int      @default(0)
  recordingUrl String?
  notes        String?
  createdAt    DateTime @default(now())
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  leadId    String?
  senderId  String?
  channel   String   @default("SYSTEM") // ZALO, WHATSAPP, MESSENGER, SMS, EMAIL, IN_APP
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  lead   Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sender User? @relation("MessageSender", fields: [senderId], references: [id])

  @@index([leadId, createdAt])
}

// ---------------------- TRANSACTION ----------------------

model Transaction {
  id               String            @id @default(cuid())
  tenantId         String
  propertyId       String
  brokerId         String?
  customerId       String?
  status           TransactionStatus @default(RESERVED)
  agreedPrice      Decimal           @db.Decimal(15, 2)
  depositAmount    Decimal?          @db.Decimal(15, 2)
  commissionAmount Decimal?          @db.Decimal(15, 2)
  contractUrl      String?
  invoiceUrl       String?
  closedAt         DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  property Property             @relation(fields: [propertyId], references: [id])
  broker   BrokerProfile?       @relation(fields: [brokerId], references: [id])
  customer CustomerProfile?     @relation(fields: [customerId], references: [id])
  mortgage MortgageApplication?

  @@index([tenantId, status])
}

// ---------------------- MORTGAGE ----------------------

model Bank {
  id           String                @id @default(cuid())
  name         String                @unique
  logoUrl      String?
  interestRate Float?
  maxLtvRatio  Float? // loan-to-value
  maxTermYears Int?
  applications MortgageApplication[]
}

model MortgageApplication {
  id             String   @id @default(cuid())
  transactionId  String?  @unique
  customerId     String
  bankId         String
  loanAmount     Decimal  @db.Decimal(15, 2)
  termYears      Int
  interestRate   Float
  monthlyPayment Decimal  @db.Decimal(15, 2)
  status         String   @default("PENDING") // PENDING, REVIEW, APPROVED, REJECTED
  documents      Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transaction Transaction? @relation(fields: [transactionId], references: [id])
  bank        Bank         @relation(fields: [bankId], references: [id])

  @@index([customerId, status])
}

// ---------------------- LEGAL ----------------------

model LegalDocument {
  id          String    @id @default(cuid())
  propertyId  String
  type        String // RED_BOOK, PINK_BOOK, PLANNING, CONSTRUCTION_LICENSE
  documentUrl String?
  issuedDate  DateTime?
  isVerified  Boolean   @default(false)
  verifiedBy  String?
  verifiedAt  DateTime?
  riskNotes   String?
  createdAt   DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, type])
}

// ---------------------- APPOINTMENT / NOTIFICATION / ENGAGEMENT ----------------------

model Appointment {
  id          String            @id @default(cuid())
  leadId      String?
  propertyId  String?
  brokerId    String?
  customerId  String?
  scheduledAt DateTime
  location    String?
  status      AppointmentStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime          @default(now())

  lead     Lead?            @relation(fields: [leadId], references: [id])
  property Property?        @relation(fields: [propertyId], references: [id])
  broker   BrokerProfile?   @relation(fields: [brokerId], references: [id])
  customer CustomerProfile? @relation(fields: [customerId], references: [id])

  @@index([brokerId, scheduledAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String?
  isRead    Boolean          @default(false)
  metadata  Json             @default("{}")
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  criteria  Json
  alertOn   Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  propertyId String?
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// ---------------------- AI ----------------------

model AiValuation {
  id              String   @id @default(cuid())
  propertyId      String
  estimatedValue  Decimal  @db.Decimal(15, 2)
  confidenceScore Float
  riskScore       Float?
  liquidityScore  Float?
  investmentScore Float?
  rentalEstimate  Decimal? @db.Decimal(15, 2)
  comparables     Json     @default("[]")
  reportUrl       String?
  modelVersion    String   @default("v1")
  createdAt       DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String?
  channel   String   @default("WEB_CHAT")
  language  String   @default("vi")
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?       @relation(fields: [userId], references: [id])
  messages AiMessage[]
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user, assistant, system
  content        String
  tokensUsed     Int?
  model          String?
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Vector embeddings for RAG / semantic search over listings, projects, articles
model Embedding {
  id         String                       @id @default(cuid())
  sourceType String // PROPERTY, PROJECT, ARTICLE, FAQ
  sourceId   String
  content    String
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())

  @@index([sourceType, sourceId])
}

// ---------------------- CMS ----------------------

model Category {
  id       String         @id @default(cuid())
  tenantId String
  name     String
  slug     String
  posts    PostCategory[]

  @@unique([tenantId, slug])
}

model Tag {
  id       String    @id @default(cuid())
  tenantId String
  name     String
  slug     String
  posts    PostTag[]

  @@unique([tenantId, slug])
}

model Post {
  id              String    @id @default(cuid())
  tenantId        String
  authorId        String?
  title           String
  slug            String
  excerpt         String?
  content         String
  coverImageUrl   String?
  status          String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  metaTitle       String?
  metaDescription String?
  schemaJsonLd    Json?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  categories PostCategory[]
  tags       PostTag[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
}

model PostCategory {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Page {
  id              String   @id @default(cuid())
  tenantId        String
  slug            String
  title           String
  blocks          Json     @default("[]") // page-builder block tree
  metaTitle       String?
  metaDescription String?
  schemaJsonLd    Json?
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, slug])
}

// ---------------------- ANALYTICS / AUDIT ----------------------

model PageView {
  id          String   @id @default(cuid())
  tenantId    String
  path        String
  userId      String?
  sessionId   String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())

  @@index([tenantId, path, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId, createdAt])
}

// ---------------------- VISITOR TRACKING, CONSENT & PRIVACY (NĐ 13/2023) ----------------------

enum TrackingEventType {
  PAGE_VIEW
  PROPERTY_VIEW
  FILTER_APPLIED
  AI_VALUATION_USED
  SAVED_SEARCH_CREATED
  FAVORITE_ADDED
  CONTACT_REQUESTED
  REVISIT
}

enum ConsentCategory {
  ESSENTIAL
  BEHAVIORAL
  ADVERTISING
}

enum DataErasureStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

/// Progressive-profiling identity graph: anonymous visitor first, merged into
/// a CRM Lead once the visitor identifies themselves (hotline/Zalo/form/AI valuation).
model VisitorProfile {
  id           String    @id @default(cuid())
  tenantId     String
  visitorKey   String // anonymous cookie / localStorage id
  leadId       String? // set at the moment of identity resolution
  isIdentified Boolean   @default(false)
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  mergedAt     DateTime?
  deviceInfo   Json?     @default("{}")

  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  lead            Lead?                @relation(fields: [leadId], references: [id])
  events          TrackingEvent[]
  consents        ConsentRecord[]
  erasureRequests DataErasureRequest[]

  @@unique([tenantId, visitorKey])
  @@index([leadId])
  @@index([tenantId, lastSeenAt])
}

/// Behavioral event log — only written for a visitor once BEHAVIORAL consent is granted
/// (see ConsentRecord). Reused as the raw signal for the recommendation engine.
model TrackingEvent {
  id               String            @id @default(cuid())
  tenantId         String
  visitorProfileId String
  propertyId       String?
  type             TrackingEventType
  durationSeconds  Int?
  scrollDepthPct   Int?
  source           String? // organic, ads, zalo, direct...
  metadata         Json              @default("{}")
  createdAt        DateTime          @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  visitorProfile VisitorProfile @relation(fields: [visitorProfileId], references: [id], onDelete: Cascade)
  property       Property?      @relation(fields: [propertyId], references: [id])

  @@index([visitorProfileId, createdAt])
  @@index([propertyId, type, createdAt])
  @@index([tenantId, type, createdAt])
}

/// Append-only consent ledger (Nghị định 13/2023 + Luật 91/2025/QH15): every grant or
/// withdrawal is its own row so we can always prove what was consented to and when.
/// ESSENTIAL is always granted (site operation); BEHAVIORAL/ADVERTISING default to false
/// and must never be activated before an explicit opt-in row exists.
model ConsentRecord {
  id               String          @id @default(cuid())
  tenantId         String
  visitorProfileId String
  category         ConsentCategory
  granted          Boolean
  consentVersion   String          @default("v1")
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime        @default(now())

  visitorProfile VisitorProfile @relation(fields: [visitorProfileId], references: [id], onDelete: Cascade)

  @@index([visitorProfileId, category, createdAt])
}

/// Data-subject erasure/access requests. dueAt must be set to requestedAt + 72h at
/// creation time by the service layer, per the 72-hour handling requirement.
model DataErasureRequest {
  id               String            @id @default(cuid())
  tenantId         String
  visitorProfileId String?
  requestedEmail   String?
  requestedPhone   String?
  status           DataErasureStatus @default(PENDING)
  requestedAt      DateTime          @default(now())
  dueAt            DateTime
  completedAt      DateTime?
  notes            String?

  visitorProfile VisitorProfile? @relation(fields: [visitorProfileId], references: [id])

  @@index([tenantId, status])
}
