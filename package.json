    "dompurify": "^3.4.1",
    "dotenv": "^17.4.1",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "file-type": "^21.3.4",
    "framer-motion": "^12.38.0",
    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "http-proxy-middleware": "^3.0.7",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.12.0",
    "motion": "^12.38.0",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.5",
    "openai": "^6.46.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "postcss": "^8.5.8",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^3.0.0",
    "react-is": "^19.2.5",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.0.2",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "ws": "^8.20.0",
    "y-websocket": "^1.5.4",
    "yjs": "^13.6.30",
    "zod": "^4.3.6"
  },
  "overrides": {
    "lodash": "^4.18.0",
    "@xmldom/xmldom": ">=0.9.0",
    "protobufjs": ">=7.5.5",
    "picomatch": "^2.3.2",
    "brace-expansion": "^5.0.5",
    "tinyglobby": {
      "picomatch": "^4.0.4"
    },
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.6",
    "@types/ioredis-mock": "^8.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.17",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "ioredis-mock": "^8.13.1",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "typescript": "~5.8.2",
    "vite": "^6.4.2",
    "vitest": "^4.1.8"
  }
