{
  "name": "sgs-land",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.js",
    "build": "node ./node_modules/vite/bin/vite.js build && esbuild server.ts --bundle --external:http-proxy-middleware --external:http-proxy --platform=node --format=esm --outfile=server.js --external:pg --external:bcrypt --external:socket.io --external:@socket.io/redis-adapter --external:redis --external:ioredis --external:bullmq --external:nodemailer --external:multer --external:file-type --external:pdf-parse --external:mammoth --external:pdfjs-dist --external:exceljs --external:ws --external:y-websocket --external:yjs --external:@google/genai --external:openai --external:@anthropic-ai/sdk --external:vite --external:express --external:cookie-parser --external:jsonwebtoken --external:helmet --external:dotenv --external:sharp --external:compression --external:cheerio --external:jsdom --external:canvas",
    "build:all": "node scripts/build-all.mjs",
    "build:next": "cd apps/nextjs && npm run build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "seed": "tsx server/seed.ts",
    "knowledge:seed": "tsx scripts/seed-knowledge.ts",
    "ai:eval": "tsx scripts/eval-agents.ts",
    "ai:eval:strict": "tsx scripts/eval-agents.ts --threshold 0.9 --per-agent 0.9",
    "ai:eval:e2e": "tsx scripts/eval-agents.ts --e2e --judge --threshold 0.9 --per-agent 0.9",
    "migrate": "tsx server/migrations/cli.ts",
    "migrate:dry": "tsx server/migrations/cli.ts --dry-run",
    "migrate:rollback": "tsx server/migrations/cli.ts --rollback",
    "test:e2e": "playwright test",
    "audit:security": "npm audit --audit-level=high",
    "audit": "node seo-geo-audit.mjs",
    "monitor": "node geo-monitor.mjs",
    "autofix": "node seo-auto-fix.mjs",
    "full": "node seo-geo-audit.mjs && node geo-monitor.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@getbrevo/brevo": "^5.0.3",
