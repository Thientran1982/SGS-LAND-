import React, { useState, useEffect } from 'react';
import { ROUTES } from '../config/routes';
import { Logo } from '../components/Logo';
import { SeoHead } from '../components/SeoHead';
interface DeveloperProject {
  name: string;
  code: string;
  location: string | null;
  status: string | null;
  totalUnits: number | null;
}
interface DeveloperData {
  slug: string;
  name: string;
  legalName: string | null;
  brand: string | null;
  stockCode: string | null;
  foundedYear: number | null;
  headquarters: string | null;
  website: string | null;
  logoUrl: string | null;
  charterCapital: string | null;
  projectsDelivered: number | null;
  landBankHa: string | null;
  awards: string[] | null;
  summary: string | null;
  description: string | null;
  faq: { q: string; a: string }[] | null;
}

function FAQAccordion({ items }: { items: { q: string; a: string }[] }) {
  const [open, setOpen] = useState<number | null>(0);
  if (!items || items.length === 0) return null;
  return (
    <div className="space-y-3">
      {items.map((it, i) => (
        <div key={i} className="border border-[var(--border)] rounded-lg overflow-hidden">
          <button
            type="button"
            onClick={() => setOpen(open === i ? null : i)}
            className="w-full text-left px-4 py-3 font-semibold flex justify-between items-center"
          >
            <span>{it.q}</span>
            <span>{open === i ? '\u2212' : '+'}</span>
          </button>
          {open === i && (
            <div className="px-4 py-3 text-[var(--text-secondary)] border-t border-[var(--border)]">
              {it.a}
            </div>
          )}
        </div>
      ))}
    </div>
  );
}
export default function DeveloperPage() {
  const parts = window.location.pathname.replace(/^\//, '').split('/');
  const slug = (parts[1] || '').toLowerCase();

  const [data, setData] = useState<DeveloperData | null>(null);
  const [projects, setProjects] = useState<DeveloperProject[]>([]);
  const [loading, setLoading] = useState(true);
  const [notFound, setNotFound] = useState(false);
  useEffect(() => {
    let active = true;
    setLoading(true);
    fetch('/api/public/developers/' + encodeURIComponent(slug))
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((json) => {
        if (!active) return;
        if (json && json.ok) {
          setData(json.developer);
          setProjects(json.projects || []);
        } else {
          setNotFound(true);
        }
      })
      .catch(() => active && setNotFound(true))
      .finally(() => active && setLoading(false));
    return () => {
      active = false;
    };
  }, [slug]);
  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center text-[var(--text-secondary)]">
        Đang tải thông tin chủ đầu tư...
      </div>
    );
  }
  if (notFound || !data) {
    return (
      <div className="min-h-screen flex flex-col items-center justify-center gap-4 px-4 text-center">
        <h1 className="text-2xl font-bold">Không tìm thấy chủ đầu tư</h1>
        <p className="text-[var(--text-secondary)]">
          Chủ đầu tư bạn tìm chưa được công khai hoặc không tồn tại.
        </p>
        <a href={'/' + ROUTES.DU_AN} className="text-[var(--accent)] underline">
          Xem tất cả dự án
        </a>
      </div>
    );
  }
  const facts: { label: string; value: React.ReactNode }[] = [];
  if (data.legalName) facts.push({ label: 'Tên pháp lý', value: data.legalName });
  if (data.stockCode) facts.push({ label: 'Mã chứng khoán', value: data.stockCode });
  if (data.foundedYear) facts.push({ label: 'Năm thành lập', value: data.foundedYear });
  if (data.headquarters) facts.push({ label: 'Trụ sở chính', value: data.headquarters });
  if (data.charterCapital) facts.push({ label: 'Vốn điều lệ', value: data.charterCapital });
  if (data.projectsDelivered != null) facts.push({ label: 'Số dự án đã bàn giao', value: data.projectsDelivered });
  if (data.landBankHa) facts.push({ label: 'Quỹ đất (ha)', value: data.landBankHa });
  if (data.website) facts.push({ label: 'Website', value: data.website });
  const title = data.name + ' – Chủ đầu tư bất động sản | SGS LAND';
  const lead =
    data.summary ||
    (data.name + ' là chủ đầu tư bất động sản' +
      (data.headquarters ? ' có trụ sở tại ' + data.headquarters : '') + '.');
  return (
    <div className="min-h-screen bg-[var(--bg)] text-[var(--text-primary)]">
      <SeoHead title={title} description={lead} />
      <header className="max-w-4xl mx-auto px-4 pt-8">
        <a href="/" aria-label="SGS LAND"><Logo /></a>
      </header>
      <main className="max-w-4xl mx-auto px-4 py-8">
        <nav className="text-sm text-[var(--text-secondary)] mb-4">
          <a href="/" className="hover:underline">Trang chủ</a> /{' '}
          <a href={'/' + ROUTES.DU_AN} className="hover:underline">Dự án</a> /{' '}
          <span>{data.name}</span>
        </nav>
        <h1 className="text-3xl md:text-4xl font-bold mb-4 leading-tight">{data.name}</h1>
        <p className="text-lg text-[var(--text-secondary)] mb-8 max-w-3xl">{lead}</p>
        {facts.length > 0 && (
          <section className="mb-10">
            <h2 className="text-xl font-bold mb-4">Thông tin doanh nghiệp</h2>
            <table className="w-full text-left border border-[var(--border)] rounded-lg overflow-hidden">
              <tbody>
                {facts.map((f, i) => (
                  <tr key={i} className="border-b border-[var(--border)] last:border-0">
                    <th className="px-4 py-3 font-medium w-1/3 align-top bg-[var(--surface)]">{f.label}</th>
                    <td className="px-4 py-3">{f.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        )}
        {data.description && (
          <section className="mb-10">
            <h2 className="text-xl font-bold mb-4">Giới thiệu {data.name}</h2>
            <p className="text-[var(--text-secondary)] leading-relaxed whitespace-pre-line">
              {data.description}
            </p>
          </section>
        )}
        {projects.length > 0 && (
          <section className="mb-10">
            <h2 className="text-xl font-bold mb-4">
              Dự án của {data.name} ({projects.length})
            </h2>
            <ul className="grid gap-3 md:grid-cols-2">
              {projects.map((p) => (
                <li key={p.code} className="border border-[var(--border)] rounded-lg p-4 hover:shadow-md transition">
                  <a href={'/' + ROUTES.DU_AN + '/' + p.code} className="font-semibold text-[var(--accent)] hover:underline">
                    {p.name}
                  </a>
                  <div className="text-sm text-[var(--text-secondary)] mt-1">
                    {p.location || ''}
                    {p.totalUnits ? ' · ' + p.totalUnits + ' sản phẩm' : ''}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )}
        {data.faq && data.faq.length > 0 && (
          <section className="mb-10">
            <h2 className="text-xl font-bold mb-4">Câu hỏi thường gặp về {data.name}</h2>
            <FAQAccordion items={data.faq} />
          </section>
        )}
      </main>
    </div>
  );
}