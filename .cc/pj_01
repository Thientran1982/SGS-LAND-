                                                        l.attributes?.tower && `${t('inventory.label_tower')} ${l.attributes.tower}`,
                                                        l.attributes?.floor && `${t('inventory.label_floor')} ${l.attributes.floor}`,
                                                    ].filter(Boolean).join(' · ')}
                                                </div>
                                            )}
