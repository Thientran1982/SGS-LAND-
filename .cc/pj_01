// ─────────────────────────────────────────────────────────────────────────────
type BulkFileItem = {
    id: string;
    file: File;
    preview: string;
    matchedCode: string | null;
    manualCode: string;
};
function normalizeBulkCode(s: string): string {
    return s.trim().toUpperCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
