function deriveCodeCandidatesClient(filename: string): string[] {
    const base = filename.replace(/\.[^.]+$/, '');
    const out = [base];
    const m = base.match(/^(.+)[-_](\d+)$/);
    if (m) out.push(m[1]);
    return out.map(normalizeBulkCode);
}
function BulkImageUploadModal({
    project, onClose, onCompleted, t,
