# ============================================================================
# SGSLand Market-Listings Pipeline — environment variables
# (Most already exist as Replit Secrets in this project.)
# ============================================================================

# --- Neon PostgreSQL (already set in this project) --------------------------
NEON_DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# DATABASE_URL / PROD_DATABASE_URL are used as fallbacks by server/db.ts

# --- Upstash Redis (already set) — rate limiting + distributed locks ---------
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# --- Upstash QStash (already set) — per-region job scheduling ----------------
QSTASH_TOKEN=xxxxxxxx
QSTASH_CURRENT_SIGNING_KEY=sig_xxx
QSTASH_NEXT_SIGNING_KEY=sig_yyy

# --- Public base URL where QStash sends webhooks ----------------------------
# Defaults to https://sgs-land.replit.app if unset.
PUBLIC_BASE_URL=https://sgs-land.replit.app

# --- Cloudinary — image storage (NEEDS TO BE ADDED) -------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=sgsland/market

# --- Mapbox — geocoding (NEEDS TO BE ADDED) ---------------------------------
# Reuses the same vendor as the frontend Mapbox GL JS.
MAPBOX_TOKEN=pk.your_mapbox_token
