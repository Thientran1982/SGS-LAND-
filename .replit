modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
[nix]
channel = "stable-25_05"
packages = [
  "psmisc",
  "glib",
  "nodejs_20",
  "nspr",
  "nss",
  "atk",
  "at-spi2-atk",
  "cups",
  "dbus",
  "expat",
  "fontconfig",
  "freetype",
  "gdk-pixbuf",
  "gtk3",
  "libdrm",
  "libgbm",
  "libxkbcommon",
  "mesa",
  "pango",
  "alsa-lib",
  "xorg.libX11",
  "xorg.libXcomposite",
  "xorg.libXdamage",
  "xorg.libXext",
  "xorg.libXfixes",
  "xorg.libXrandr",
  "xorg.libXcursor",
  "xorg.libXi",
  "xorg.libXrender",
  "xorg.libXtst",
  "xorg.libXScrnSaver",
  "xorg.libxcb",
  "xorg.libXau",
  "xorg.libXdmcp"
]
[workflows]
runButton = "Project"
[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"
[[workflows.workflow]]
name = "Start application"
author = "agent"
[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "fuser -k 5000/tcp 5001/tcp 2>/dev/null; sleep 1; PORT=5001 npm run dev >/tmp/sgs-backend.log 2>&1 & BACKEND_PID=$!; trap 'kill $BACKEND_PID 2>/dev/null || true' EXIT INT TERM; cd apps/nextjs && BACKEND_URL=http://localhost:5001 npm run dev -- --hostname 0.0.0.0 --port 5000"
waitForPort = 5000
[[workflows.workflow]]
name = "typecheck"
author = "agent"
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run lint"
[workflows.workflow.metadata]
isValidation = true
[[workflows.workflow]]
name = "Next.js Public Site"
author = "agent"
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/nextjs && npm run dev -- --port 3001"
waitForPort = 3001
[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3003

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5099
externalPort = 4200

[[ports]]
localPort = 5510
externalPort = 5000

[[ports]]
localPort = 5511
externalPort = 5173

[[ports]]
localPort = 23636
externalPort = 3000

[[ports]]
localPort = 23637
externalPort = 3002

[deployment]
deploymentTarget = "vm"
run = ["npm", "run", "start:production"]
build = ["sh", "-c", "npm run build && cd apps/nextjs && npm install && BACKEND_URL=http://localhost:5001 npm run build && cd ../.. && npm run check:production-startup && bash scripts/prepare-publish.sh && npm run check:publish-size"]
[userenv]
[userenv.shared]
COMMISSION_RATE = "0.02"
MARKET_CACHE_TTL_HOURS = "6"
BREVO_FROM_EMAIL = "noreply@sgsland.vn"
BREVO_FROM_NAME = "SGS LAND"
ALLOWED_ORIGINS = "https://sgsland.vn,https://www.sgsland.vn"
AI_ORCHESTRATION_MODE = "langgraph"
GSC_SITE_URL = "sc-domain:sgsland.vn"
QSTASH_URL = "https://qstash-us-east-1.upstash.io"
LANGGRAPH_ORCHESTRATION_ADAPTER_READY = "true"
LANGGRAPH_ORCHESTRATION_APPROVED = "true"
PUBLIC_URL = "https://sgsland.vn"
[userenv.development]
NODE_ENV = "development"
PORT = "5000"
[userenv.production]
NODE_ENV = "production"
PORT = "5000"
APP_URL = "https://sgsland.vn"
PROD_DOMAIN = "sgsland.vn"
[objectStorage]
defaultBucketID = "replit-objstore-b2bda06e-8535-430b-b2ac-45839c6a59c1"
[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
