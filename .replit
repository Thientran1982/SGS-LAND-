modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
[nix]
channel = "stable-25_05"
packages = ["psmisc"]
[workflows]
runButton = "Project"
[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"
[[workflows.workflow]]
name = "Start application"
author = "agent"
[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "fuser -k 5000/tcp 5001/tcp 2>/dev/null; sleep 1; PORT=5001 npm run dev & sleep 8 && cd apps/nextjs && BACKEND_URL=http://localhost:5001 npm run build && BACKEND_URL=http://localhost:5001 ./node_modules/.bin/next start --hostname 0.0.0.0 --port 5000"
waitForPort = 5000
[[workflows.workflow]]
name = "typecheck"
author = "agent"
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run lint"
[workflows.workflow.metadata]
isValidation = true
[[workflows.workflow]]
name = "Next.js Public Site"
author = "agent"
[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/nextjs && npm run dev -- --port 3001"
waitForPort = 3001
[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 8081

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3005
externalPort = 3003

[[ports]]
localPort = 3009
externalPort = 8099

[[ports]]
localPort = 3011
externalPort = 8080

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 5173

[[ports]]
localPort = 5002
externalPort = 6000

[[ports]]
localPort = 5003
externalPort = 6800
exposeLocalhost = true

[[ports]]
localPort = 5004
externalPort = 8000

[[ports]]
localPort = 5005
externalPort = 8008

[[ports]]
localPort = 5050
externalPort = 5000

[[ports]]
localPort = 8099
externalPort = 9000

[[ports]]
localPort = 23636
externalPort = 3000

[[ports]]
localPort = 23637
externalPort = 3002

[[ports]]
localPort = 23638
externalPort = 4200

[deployment]
deploymentTarget = "vm"
run = ["sh", "-c", "PORT_BACKEND=5001 PORT=5000 bash scripts/supervisor.sh"]
build = ["sh", "-c", "npm run build && cd apps/nextjs && npm install && BACKEND_URL=http://localhost:5001 npm run build"]
[userenv]
[userenv.shared]
COMMISSION_RATE = "0.02"
MARKET_CACHE_TTL_HOURS = "6"
BREVO_FROM_EMAIL = "noreply@sgsland.vn"
BREVO_FROM_NAME = "SGS LAND"
ALLOWED_ORIGINS = "https://sgsland.vn,https://www.sgsland.vn"
AI_ORCHESTRATION_MODE = "langgraph"
LANGGRAPH_ORCHESTRATION_ADAPTER_READY = "true"
LANGGRAPH_ORCHESTRATION_APPROVED = "true"
[userenv.development]
NODE_ENV = "development"
PORT = "5000"
[userenv.production]
NODE_ENV = "production"
PORT = "5000"
APP_URL = "https://sgsland.vn"
[objectStorage]
defaultBucketID = "replit-objstore-b2bda06e-8535-430b-b2ac-45839c6a59c1"
[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
