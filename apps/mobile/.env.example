EXPO_PUBLIC_API_BASE_URL=https://sgsland.vn

# ── VNPay deposit booking (Sprint 6) ─────────────────────────────────────
# The mobile app does NOT need any VNPay credentials. The payment URL is
# signed by the backend (`POST /api/bookings`) and returned to the client,
# which simply opens it in expo-web-browser. All VNPay env vars
# (VNPAY_ENV / VNPAY_TMN_CODE / VNPAY_HASH_SECRET / VNPAY_RETURN_URL /
# VNPAY_IPN_URL) live in the SERVER `.env` only.
