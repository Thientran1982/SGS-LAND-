{
  "expo": {
    "name": "SGS Land",
    "slug": "sgsland-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sgsland",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.sgsland.buyer",
      "buildNumber": "3",
      "associatedDomains": ["applinks:sgsland.vn"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "SGS Land sử dụng máy ảnh để bạn chụp giấy tờ và hình ảnh bất động sản khi đăng tin hoặc trao đổi với chuyên viên.",
        "NSPhotoLibraryUsageDescription": "SGS Land cần quyền truy cập thư viện ảnh để bạn chọn ảnh bất động sản đính kèm tin đăng hoặc gửi cho chuyên viên.",
        "NSPhotoLibraryAddUsageDescription": "SGS Land cần quyền lưu ảnh vào thư viện để bạn tải hình ảnh sản phẩm hoặc biên nhận đặt cọc.",
        "NSLocationWhenInUseUsageDescription": "SGS Land sử dụng vị trí của bạn để gợi ý bất động sản gần nơi bạn đang đứng và tính khoảng cách tới sản phẩm.",
        "NSUserTrackingUsageDescription": "Cho phép SGS Land đo lường ẩn danh cách bạn dùng ứng dụng để cải thiện gợi ý sản phẩm và hiệu năng — chúng tôi không bán dữ liệu của bạn cho bên thứ ba."
      }
    },
    "android": {
      "package": "vn.sgsland.buyer",
      "versionCode": 3,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "sgsland.vn", "pathPrefix": "/bds" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#ffffff"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": ""
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    }
  }
}