{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/types": [
        "./types/index.ts"
      ],
      "@/types/*": [
        "./types/*"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/services/*": [
        "./services/*"
      ],
      "@/utils/*": [
        "../../utils/*"
      ],
      "@/hooks/*": [
        "./hooks/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@sgs/chat-widget": [
        "../../packages/chat-widget/src/index.ts"
      ],
      "@sgs/chat-widget/*": [
        "../../packages/chat-widget/src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../../../types/**/*.ts",
    "../../../../types.ts",
    "../../packages/chat-widget/src/**/*.ts",
    "../../packages/chat-widget/src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "artifacts",
    "__tests__"
  ]
}
